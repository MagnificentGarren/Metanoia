<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBgColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- App Logo & Header -->
        <ImageView
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_profile_avatar"
            android:padding="16dp"
            android:src="@drawable/ic_metanoia_logo"
            android:contentDescription="Metanoia Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="METANOIA"
            android:textColor="#D4AF37"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mindful Focus &amp; Productivity"
            android:textColor="#8E8E93"
            android:textSize="15sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp" />

        <!-- Segmented Tab Bar (Log In vs Sign Up) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="4dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnTabLogIn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:text="LOG IN"
                android:textColor="#0A0A0A"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTabSignUp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_unselected"
                android:text="SIGN UP"
                android:textColor="#8E8E93"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Input Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_outline"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <!-- Full Name (Sign Up only) -->
            <TextView
                android:id="@+id/lblAuthName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAuthName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_rounded"
                android:hint="John Doe"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:paddingHorizontal="16dp"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvErrorAuthName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="12dp" />

            <!-- Email Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAuthEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_rounded"
                android:hint="user@example.com"
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvErrorAuthEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="12dp" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="6dp">

                <EditText
                    android:id="@+id/etAuthPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_search_rounded"
                    android:hint="••••••••"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:inputType="textPassword"
                    android:autofillHints="password" />

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_eye_toggle"
                    android:contentDescription="Toggle Password Visibility"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#8E8E93" />
            </RelativeLayout>

            <!-- Forgot Password Link (Log In mode) -->
            <TextView
                android:id="@+id/btnForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Forgot Password?"
                android:textColor="#D4AF37"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingVertical="4dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvErrorAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="12dp" />

            <!-- Confirm Password (Sign Up only) -->
            <TextView
                android:id="@+id/lblAuthConfirmPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRM PASSWORD"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="6dp" />

            <RelativeLayout
                android:id="@+id/layoutConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etAuthConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_search_rounded"
                    android:hint="••••••••"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#555555"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:inputType="textPassword"
                    android:autofillHints="password" />

                <ImageView
                    android:id="@+id/btnToggleConfirmPassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_eye_toggle"
                    android:contentDescription="Toggle Confirm Password Visibility"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#8E8E93" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvErrorAuthConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvAuthGlobalError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Progress Bar Loading Overlay -->
            <ProgressBar
                android:id="@+id/pbAuthLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="#D4AF37"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Primary Action Button -->
            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#D4AF37"
                android:text="LOG IN"
                android:textColor="#0A0A0A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- OR Divider Line -->
            <LinearLayout
                android:id="@+id/layoutOrDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2C2C2E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  OR  "
                    android:textColor="#8E8E93"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#2C2C2E" />
            </LinearLayout>

            <!-- Google Sign-In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuthGoogle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#1C1C1E"
                app:icon="@drawable/ic_google_logo"
                app:iconTint="@null"
                android:drawableTint="@null"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconPadding="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="CONTINUE WITH GOOGLE"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Continue as Guest / Skip -->
        <Button
            android:id="@+id/btnAuthGuest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#1C1C1E"
            android:text="CONTINUE AS GUEST"
            android:textColor="#D4AF37"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Security & Email Verification Notice -->
        <TextView
            android:id="@+id/tvAuthNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Production Email Verification required for synced accounts."
            android:textColor="#8E8E93"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>

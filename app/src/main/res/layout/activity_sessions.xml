<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- 1. Top Bar -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivMenu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Menu"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#D4AF37" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="METANOIA"
                android:textColor="#D4AF37"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION HISTORY"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Profile"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#D4AF37" />
    </RelativeLayout>

    <!-- 2. Search & Filter Bar -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/bg_search_rounded"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search &amp; Filter"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6C6C70"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_search_rounded"
            android:contentDescription="Filter"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#D4AF37" />
    </LinearLayout>

    <!-- 3. Calendar Section -->
    <LinearLayout
        android:id="@+id/layoutCalendarSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutSearch"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/btnCalendarToggle"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Toggle Calendar"
            android:src="@drawable/ic_chevron_down"
            app:tint="#D4AF37" />
    </LinearLayout>

    <!-- Full Month Calendar View (Initially Hidden) -->
    <CalendarView
        android:id="@+id/monthCalendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutSearch"
        android:layout_marginTop="16dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:visibility="gone" />

    <!-- Scrollable Content Area for Stats & Session Cards -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomNav"
        android:layout_below="@id/layoutCalendarSection"
        android:layout_marginTop="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 4. Dynamic Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Worked Time Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Worked"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvWorkedHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#D4AF37"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" hrs "
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvWorkedMins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#D4AF37"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" mins"
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Simple Visual Bar Chart Indicator -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Total Sessions Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sessions"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTotalSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#D4AF37"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Deep Work Sessions"
                        android:textColor="#8E8E93"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Dynamic Sessions List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 6. Two-Tab Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_rounded"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Dashboard"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSessions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_outline"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Sessions"
            android:textColor="#D4AF37"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
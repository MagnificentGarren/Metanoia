<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark"
    android:orientation="vertical">

    <!-- Scrollable container for perfect screen scaling, small/landscape screens, and dynamic lists -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header with Premium Design -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FILTER &amp; SORT"
                        android:textColor="#D4A359"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refine your focus session history"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCloseFilter"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_unselected"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_cancel"
                    android:padding="8dp"
                    app:tint="#D4A359" />
            </RelativeLayout>

            <!-- Card: Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outline"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION CATEGORY"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <!-- Category chip container -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/llCategoryChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">
                        <!-- Dynamic Category Buttons added here by code -->
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Create Custom Tag Input Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search_rounded"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp">

                    <EditText
                        android:id="@+id/etNewCategoryTag"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Create new custom tag..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#55FFFFFF"
                        android:textSize="13sp"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:maxLines="1" />

                    <ImageButton
                        android:id="@+id/btnAddNewCategoryTag"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_add"
                        app:tint="#D4A359"
                        android:contentDescription="Add Custom Tag" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: Sort Options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_outline"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SORT ORDER"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSortNewest"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_selected"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp"
                        android:text="Newest"
                        android:textAllCaps="false"
                        android:textColor="#0A0A0A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="12sp" />

                    <Button
                        android:id="@+id/btnSortOldest"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp"
                        android:text="Oldest"
                        android:textAllCaps="false"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="12sp" />

                    <Button
                        android:id="@+id/btnSortLongest"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_unselected"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp"
                        android:text="Longest"
                        android:textAllCaps="false"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="9sp"
                        app:autoSizeMaxTextSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnResetFilter"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingHorizontal="8dp"
                    android:text="RESET ALL"
                    android:textColor="#FF4F4F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp" />

                <Button
                    android:id="@+id/btnApplyFilter"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_button_gold"
                    android:paddingHorizontal="8dp"
                    android:text="APPLY FILTERS"
                    android:textColor="#0A0A0A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

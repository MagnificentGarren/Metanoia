<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomNav" />

    <TextView
        android:id="@+id/profileIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_profile_avatar"
        android:contentDescription="@string/profile_settings_title"
        android:gravity="center"
        android:textColor="@color/gold_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless" />

    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_search_rounded"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_outline"
            android:gravity="center"
            android:includeFontPadding="false"
            app:drawableTopCompat="@drawable/ic_dashboard"
            app:drawableTint="@color/gold_primary"
            android:drawablePadding="4dp"
            android:text="Dashboard"
            android:textColor="#D4AF37"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSessions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:includeFontPadding="false"
            app:drawableTopCompat="@drawable/ic_sessions"
            app:drawableTint="@color/text_light_grey"
            android:drawablePadding="4dp"
            android:text="Sessions"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/navProjects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:includeFontPadding="false"
            app:drawableTopCompat="@drawable/ic_projects"
            app:drawableTint="@color/text_light_grey"
            android:drawablePadding="4dp"
            android:text="Projects"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navAchievements"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:includeFontPadding="false"
            app:drawableTopCompat="@drawable/ic_medals"
            app:drawableTint="@color/text_light_grey"
            android:drawablePadding="4dp"
            android:text="Medals"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>

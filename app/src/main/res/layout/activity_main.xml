<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="FOCUS\nDASHBOARD"
        android:textAlignment="center"
        android:textColor="@color/gold_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/cardTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeader"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_gold_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT FOCUS"
            android:textColor="@color/gold_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTimerMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Mode: Count Down"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            app:useMaterialThemeColors="true" />

        <LinearLayout
            android:id="@+id/layoutPresetChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip25m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_calendar_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="25m"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip45m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_calendar_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="45m"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip50m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_calendar_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="50m"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip1h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_calendar_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="1h"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.example.myapplicationtoday.CustomWheelPicker
                android:id="@+id/pickerHours"
                android:layout_width="65dp"
                android:layout_height="120dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="h"
                android:textColor="@color/gold_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.example.myapplicationtoday.CustomWheelPicker
                android:id="@+id/pickerMinutes"
                android:layout_width="65dp"
                android:layout_height="120dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="m"
                android:textColor="@color/gold_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.example.myapplicationtoday.CustomWheelPicker
                android:id="@+id/pickerSeconds"
                android:layout_width="65dp"
                android:layout_height="120dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="s"
                android:textColor="@color/gold_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimerDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:text="00:00:00"
            android:textColor="@color/gold_primary"
            android:textSize="48sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCategoryTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_calendar_unselected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="• Deep Work ▾"
            android:textColor="@color/gold_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etSessionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="Name your session..."
            android:inputType="textPersonName"
            android:text="Deep Work Session"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnToggleTimer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/gold_primary"
            android:text="START SESSION ▶"
            android:textColor="@color/bg_dark"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEndSession"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="End &amp; Save Session ■"
            android:textColor="@color/gold_primary"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelSession"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cancel Session ✕"
            android:textColor="#FF5252"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_rounded"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_outline"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Dashboard"
            android:textColor="#D4AF37"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSessions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Sessions"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
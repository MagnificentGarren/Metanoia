<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btnBackFromProject"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/gold_primary" />

    <TextView
        android:id="@+id/tvProjectDetailEmoji"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_circle_selectable"
        android:gravity="center"
        android:text="💻"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/tvProjectDetailName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvProjectDetailEmoji"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProjectDetailTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvProjectDetailName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:textColor="@color/gold_primary"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/layoutProjectDetailGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvProjectDetailTotalTime"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressProjectDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:trackColor="#1AFFFFFF"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/tvProjectDetailGoalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:textColor="#8E8E93"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHistoryHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutProjectDetailGoal"
        android:layout_marginTop="40dp"
        android:text="PROJECT HISTORY"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProjectSessions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvHistoryHeader"
        android:layout_marginTop="12dp"
        android:scrollbars="none" />

</RelativeLayout>

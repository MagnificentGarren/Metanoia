<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- 1. Top Bar -->
    <TextView
        android:id="@+id/tvSessionsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="SESSION\nHISTORY"
        android:textAlignment="center"
        android:textColor="@color/gold_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 2. Search & Filter Bar -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSessionsHeader"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/bg_search_rounded"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search &amp; Filter"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6C6C70"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_search_rounded"
            android:contentDescription="Filter"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#D4AF37" />
    </LinearLayout>

    <!-- 3. Calendar Section -->
    <LinearLayout
        android:id="@+id/layoutCalendarSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutSearch"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCalendarToggle"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:layout_below="@id/layoutCalendarSection"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Toggle Calendar"
        android:padding="4dp"
        android:rotation="180"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chevron_down"
        app:tint="#D4AF37" />

    <!-- Scrollable Content Area for Stats & Session Cards -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnCalendarToggle"
        android:layout_marginTop="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 4. Dynamic Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Worked Time Card -->
                <LinearLayout
                    android:id="@+id/cardWorkedBlock"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="#121212">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Worked"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvWorkedHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#D4AF37"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" hrs "
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvWorkedMins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#D4AF37"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" mins"
                            android:textColor="#8E8E93"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Simple Visual Bar Chart Indicator -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Total Sessions Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sessions"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTotalSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#D4AF37"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Deep Work Sessions"
                        android:textColor="#8E8E93"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Dynamic Sessions List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>

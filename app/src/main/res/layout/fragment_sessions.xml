<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- 1. Top Header & Segmented View Switcher -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSessionsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="SESSION HISTORY"
            android:textColor="@color/gold_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <!-- Segmented Week/Month Mode Switcher Bar (Placed below header on left) -->
        <LinearLayout
            android:id="@+id/layoutViewToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="3dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewWeek"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Week"
                android:textAllCaps="false"
                android:textColor="#0A0A0A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewMonth"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Month"
                android:textAllCaps="false"
                android:textColor="#8E8E93"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Month Navigation Header (Shown when Month View is Active) -->
    <RelativeLayout
        android:id="@+id/layoutMonthHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutTopHeader"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Month"
            android:src="@drawable/ic_chevron_down"
            android:rotation="90"
            app:tint="#D4AF37" />

        <TextView
            android:id="@+id/tvMonthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="OCTOBER 2023"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Month"
            android:src="@drawable/ic_chevron_down"
            android:rotation="270"
            app:tint="#D4AF37" />
    </RelativeLayout>

    <!-- 3. Day of Week Labels (Shown for Month View Grid) -->
    <LinearLayout
        android:id="@+id/layoutDayOfWeekHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutMonthHeader"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#8E8E93" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#8E8E93" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="#8E8E93" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="W" android:textColor="#8E8E93" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="T" android:textColor="#8E8E93" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="F" android:textColor="#8E8E93" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#8E8E93" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Calendar Containers (Week Strip & Month Grid) -->
    <LinearLayout
        android:id="@+id/layoutCalendarSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutDayOfWeekHeader"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Week Horizontal Strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <!-- Month 7-Column Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMonthGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCalendarToggle"
        android:layout_width="48dp"
        android:layout_height="28dp"
        android:layout_below="@id/layoutCalendarSection"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Toggle Calendar"
        android:padding="2dp"
        android:rotation="180"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chevron_down"
        app:tint="#D4AF37" />

    <!-- 5. Search & Filter Bar -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnCalendarToggle"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/bg_search_rounded"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search &amp; Filter"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6C6C70"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_search_rounded"
            android:contentDescription="Filter"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#D4AF37" />
    </LinearLayout>

    <!-- Active Filter Indicator Chip -->
    <TextView
        android:id="@+id/tvActiveFilterPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutSearch"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_selected"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="Filter: Deep Work ✕"
        android:textColor="#0A0A0A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 6. Scrollable Content Area for Stats, Sessions & Empty State -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvActiveFilterPill"
        android:layout_marginTop="10dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Worked Time Card -->
                <LinearLayout
                    android:id="@+id/cardWorkedBlock"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:backgroundTint="#121212">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Worked"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvWorkedHours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#D4AF37"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="h "
                            android:textColor="#8E8E93"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvWorkedMins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="#D4AF37"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="m"
                            android:textColor="#8E8E93"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Dynamic Visual 7-Bar Weekly Focus Chart -->
                    <LinearLayout
                        android:id="@+id/layoutWeeklyBars"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <View
                            android:id="@+id/barDay0"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:id="@+id/barDay1"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:id="@+id/barDay2"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:id="@+id/barDay3"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:id="@+id/barDay4"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:id="@+id/barDay5"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />

                        <View
                            android:id="@+id/barDay6"
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="#3A3A3C" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Total Sessions Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_outline"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sessions"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTotalSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#D4AF37"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Deep Work Sessions"
                        android:textColor="#8E8E93"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dynamic Sessions List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State Container -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_outline"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="No sessions"
                    android:src="@drawable/ic_sessions"
                    app:tint="#6C6C70" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No Sessions Found"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptySubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="No focus sessions logged for this day or filter criteria."
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEmptyAction"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_gold"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Start Session"
                    android:textAllCaps="false"
                    android:textColor="#0A0A0A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>

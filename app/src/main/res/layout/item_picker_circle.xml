<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <View
        android:id="@+id/viewPickerCircle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_circle_selectable"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <TextView
        android:id="@+id/tvPickerEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/viewPickerCircle"
        app:layout_constraintEnd_toEndOf="@id/viewPickerCircle"
        app:layout_constraintStart_toStartOf="@id/viewPickerCircle"
        app:layout_constraintTop_toTopOf="@id/viewPickerCircle" />

</androidx.constraintlayout.widget.ConstraintLayout>

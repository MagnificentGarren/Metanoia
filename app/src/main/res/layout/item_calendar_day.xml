<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDayContainer"
    android:layout_width="52dp"
    android:layout_height="68dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_calendar_day_unselected"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvDayName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon"
        android:textColor="#8E8E93"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="10"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/vSessionDot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_chip_selected"
        android:visibility="invisible" />

</LinearLayout>

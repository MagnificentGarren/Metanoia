<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvEditProfileHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/dialog_edit_profile_title"
            android:textColor="@color/gold_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCancelEditProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#8E8E93"
            android:contentDescription="Cancel" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="USERNAME"
        android:textColor="#8E8E93"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProfileNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_rounded"
        android:hint="@string/dialog_edit_name_hint"
        android:inputType="textPersonName|textCapWords"
        android:minHeight="48dp"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#8E8E93" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="INITIALS (1-3 CHARACTERS)"
        android:textColor="#8E8E93"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etProfileInitialsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_rounded"
        android:hint="@string/dialog_edit_initials_hint"
        android:inputType="textCapCharacters"
        android:maxLength="3"
        android:minHeight="48dp"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#8E8E93" />

    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/gold_primary"
        android:text="@string/dialog_edit_save_button"
        android:textColor="#0A0A0A"
        android:textStyle="bold" />

</LinearLayout>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Gold Dark (Signature Theme) -->
    <style name="Theme.Metanoia.GoldDark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#0D0D0D</item>
        <item name="appBgColor">#0D0D0D</item>
        <item name="appCardBgColor">#181818</item>
        <item name="appCardStrokeColor">#2C2C2E</item>
        <item name="appPrimaryColor">#D4A359</item>
        <item name="appTextColorPrimary">#FFFFFF</item>
        <item name="appTextColorSecondary">#8A8A8E</item>
        <item name="colorPrimary">#D4A359</item>
        <item name="colorSurface">#181818</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8A8A8E</item>
    </style>

    <!-- Gold Light (Sunlit Gold Theme) -->
    <style name="Theme.Metanoia.GoldLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#F5F5F7</item>
        <item name="appBgColor">#F5F5F7</item>
        <item name="appCardBgColor">#FFFFFF</item>
        <item name="appCardStrokeColor">#E5E5EA</item>
        <item name="appPrimaryColor">#B87A28</item>
        <item name="appTextColorPrimary">#1C1C1E</item>
        <item name="appTextColorSecondary">#6C6C70</item>
        <item name="colorPrimary">#B87A28</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1C1C1E</item>
        <item name="android:textColorPrimary">#1C1C1E</item>
        <item name="android:textColorSecondary">#6C6C70</item>
    </style>

    <style name="Base.Theme.MyApplicationToday" parent="Theme.Metanoia.GoldDark" />

    <style name="Theme.MyApplicationToday" parent="Base.Theme.MyApplicationToday" />

    <style name="NumberPickerTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:textColorPrimary">?attr/appTextColorPrimary</item>
        <item name="colorControlNormal">?attr/appPrimaryColor</item>
        <item name="android:editTextColor">?attr/appTextColorPrimary</item>
    </style>

</resources>
